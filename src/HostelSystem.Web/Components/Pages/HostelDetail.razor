@page "/hostels/{Id:int}"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Hostel Detail — HostelSystem</PageTitle>

@if (isLoading)
{
    <p>Loading hostel...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (hostel is null)
{
    <p>Hostel not found.</p>
}
else
{
    <h3>@hostel.Name <small class="text-muted">#@hostel.Id</small></h3>
    <p>@hostel.Address</p>
    <p class="text-muted">@hostel.Description</p>
    <p><span class="badge bg-primary">@hostel.TotalCapacity capacity</span> <span class="badge bg-success">@hostel.AvailableSpots available</span></p>

    <h5 class="mt-4">Available Rooms</h5>
    @if (roomsLoading)
    {
        <p>Loading rooms...</p>
    }
    else if (rooms.Count == 0)
    {
        <div class="alert alert-info">No available rooms currently.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in rooms)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h6 class="card-title">@r.RoomNumber <small class="text-muted">(@r.CurrentOccupancy/@r.Capacity)</small></h6>
                            <p class="card-text">GHS @r.PricePerSemester / semester</p>
                            <p><span class="badge @(r.IsAvailable ? "bg-success" : "bg-secondary")">@(r.IsAvailable ? "Available" : "Full")</span></p>
                            <button class="btn btn-sm btn-primary" @onclick="() => Apply(r.Id)" disabled="@(applyBusy == r.Id)">
                                @(applyBusy == r.Id ? "Applying..." : "Apply for this room")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(applyMsg))
    {
        <div class="alert @(applyError ? "alert-danger" : "alert-success") mt-3">@applyMsg</div>
    }
    <p class="mt-3"><a href="/hostels">&larr; Back to hostels</a> • <a href="/applications">My Applications</a></p>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] public IConfiguration Config { get; set; } = default!;
    private string apiBase => Config["ApiBaseUrl"] ?? "http://localhost:8080";
    private HostelDto? hostel;
    private List<RoomDto> rooms = new();
    private bool isLoading = true; private bool roomsLoading = true;
    private string? error;
    private string? applyMsg; private bool applyError;
    private int? applyBusy;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; roomsLoading = true; error = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            // hostel
            var hRes = await client.GetAsync($"{apiBase}/api/v1.0/Hostels/{Id}");
            if (!hRes.IsSuccessStatusCode) { error = await hRes.Content.ReadAsStringAsync(); }
            else
            {
                var hBody = await hRes.Content.ReadAsStringAsync();
                hostel = System.Text.Json.JsonSerializer.Deserialize<HostelDto>(hBody, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true });
                // rooms
                var rRes = await client.GetAsync($"{apiBase}/api/v1.0/Rooms/available/{Id}");
                if (rRes.IsSuccessStatusCode)
                {
                    var rBody = await rRes.Content.ReadAsStringAsync();
                    rooms = System.Text.Json.JsonSerializer.Deserialize<List<RoomDto>>(rBody, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true}) ?? new();
                }
            }
        }
        catch (Exception ex) { error = ex.Message; }
        isLoading = false; roomsLoading = false;
    }

    private async Task Apply(int roomId)
    {
        applyBusy = roomId; applyMsg = "Submitting..."; applyError = false;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            // 1) resolve studentId from JWT (requires sign-in)
            var meRes = await client.GetAsync($"{apiBase}/api/v1.0/Students/me");
            var meBody = await meRes.Content.ReadAsStringAsync();
            if (!meRes.IsSuccessStatusCode)
            {
                if ((int)meRes.StatusCode == 401) applyMsg = "Please sign in first (session expired). Go to Login.";
                else if ((int)meRes.StatusCode == 404) applyMsg = "Student profile not found — register again or contact admin.";
                else applyMsg = $"Cannot load profile ({(int)meRes.StatusCode}): {ExtractError(meBody)}";
                applyError = true; return;
            }
            using var doc = System.Text.Json.JsonDocument.Parse(meBody);
            if (!doc.RootElement.TryGetProperty("student", out var st) || !st.TryGetProperty("id", out var idEl))
            { applyMsg = "Invalid profile response."; applyError = true; return; }
            var studentId = idEl.GetInt32();

            // 2) submit application (API validates: no pending, not allocated, room available)
            var payload = new { StudentId = studentId, RoomId = roomId };
            var res = await client.PostAsJsonAsync($"{apiBase}/api/v1.0/Applications", payload);
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                applyMsg = $"Apply failed ({(int)res.StatusCode}): {ExtractError(body)}";
                applyError = true;
                // surface common 400 details
                if (body.Contains("already have a pending", StringComparison.OrdinalIgnoreCase))
                    applyMsg += " — check My Applications.";
                if (body.Contains("already allocated", StringComparison.OrdinalIgnoreCase))
                    applyMsg += " — you already have a room.";
                return;
            }
            applyMsg = "Applied! Check My Applications for status.";
            applyError = false;
            // refresh available rooms (occupancy may not change until approved, but still)
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            applyMsg = $"Error: {ex.Message}";
            applyError = true;
            Console.WriteLine($"Apply error for room {roomId}: {ex}");
        }
        finally { applyBusy = null; }
    }

    private static string ExtractError(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "(empty response)";
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(json);
            if (d.RootElement.TryGetProperty("error", out var e) && e.ValueKind == System.Text.Json.JsonValueKind.String) return e.GetString()!;
            if (d.RootElement.TryGetProperty("title", out var t) && t.ValueKind == System.Text.Json.JsonValueKind.String) return t.GetString()!;
            if (d.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object && d.RootElement.TryGetProperty("value", out var v))
                return v.ToString();
        } catch {}
        return json.Length > 300 ? json[..300] : json;
    }

    private record HostelDto(int Id, string Name, string? Description, string Address, bool IsActive, int TotalCapacity, int TotalOccupancy, int AvailableSpots);
    private record RoomDto(int Id, string RoomNumber, int Capacity, int CurrentOccupancy, decimal PricePerSemester, bool IsAvailable, int HostelId, string HostelName);
}
