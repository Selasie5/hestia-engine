@page "/hostels/{Id:int}"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@using HostelSystem.Web.Services.Auth
@attribute [AllowAnonymous]

<PageTitle>Hostel Detail — HostelSystem</PageTitle>

<div class="hostel-detail-page">
@if (isLoading)
{
    <div class="detail-loading" aria-busy="true"><span class="spinner-border text-primary" aria-hidden="true"></span><span>Loading hostel…</span></div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (hostel is null)
{
    <p>Hostel not found.</p>
}
else
{
    <header class="detail-heading">
        <a class="detail-back" href="/hostels">← All hostels</a>
        <div class="detail-title-row">
            <div><span class="eyebrow">Hostel details</span><h1>@hostel.Name</h1><p>@hostel.Address</p></div>
            <span class="detail-availability">@hostel.AvailableSpots spaces available</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(hostel.Description)) { <p class="detail-description">@hostel.Description</p> }
    </header>

    <div class="rooms-heading"><div><h2>Available rooms</h2><p>Choose the room that works best for you.</p></div><span>@rooms.Count @(rooms.Count == 1 ? "room" : "rooms")</span></div>
    @if (roomsLoading)
    {
        <p>Loading rooms...</p>
    }
    else if (rooms.Count == 0)
    {
        <div class="alert alert-info">No available rooms currently.</div>
    }
    else
    {
        <div class="room-grid">
            @foreach (var r in rooms)
            {
                <article class="room-card">
                    <div class="room-image-wrap"><img src="/room-placeholder.jpg" alt="A furnished student room representative of room @r.RoomNumber" loading="lazy" /><span class="room-status @(r.IsAvailable ? null : "full")">@(r.IsAvailable ? "Available" : "Full")</span></div>
                    <div class="room-card-body">
                        <div class="room-title"><div><span>Room</span><h3>@r.RoomNumber</h3></div><span class="room-capacity">@r.CurrentOccupancy of @r.Capacity occupied</span></div>
                        <div class="room-price"><strong>GHS @r.PricePerSemester.ToString("N2")</strong><span>per semester</span></div>
                        <AuthorizeView>
                            <Authorized>
                                <button class="btn btn-primary room-apply" @onclick="() => Apply(r.Id)" disabled="@(!r.IsAvailable || applyBusy is not null)">
                                    @if (applyBusy == r.Id) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
                                    @(applyBusy == r.Id ? "Submitting application…" : r.IsAvailable ? "Apply for this room" : "Room currently full")
                                </button>
                            </Authorized>
                            <NotAuthorized>
                                <a class="btn btn-primary room-apply" href="@($"/login?returnUrl={Uri.EscapeDataString($"/hostels/{Id}")}")">Sign in to apply</a>
                            </NotAuthorized>
                        </AuthorizeView>
                        @if (feedbackRoomId == r.Id && !string.IsNullOrWhiteSpace(applyMsg))
                        {
                            <div class="room-feedback @(applyError ? "error" : "success")" role="status" aria-live="polite">@applyMsg</div>
                        }
                    </div>
                </article>
            }
        </div>
    }
    <p class="detail-footer"><a href="/hostels">&larr; Back to hostels</a><a href="/applications">My applications →</a></p>
}
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] public AuthService Auth { get; set; } = default!;
    [Inject] public NavigationManager Nav { get; set; } = default!;
    private HostelDto? hostel;
    private List<RoomDto> rooms = new();
    private bool isLoading = true; private bool roomsLoading = true;
    private string? error;
    private string? applyMsg; private bool applyError;
    private int? applyBusy;
    private int? feedbackRoomId;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; roomsLoading = true; error = null;
        try
        {
            var client = await Auth.CreateAuthenticatedApiClientAsync();
            // hostel
            var hRes = await client.GetAsync($"/api/v1.0/Hostels/{Id}");
            if (!hRes.IsSuccessStatusCode) { error = await hRes.Content.ReadAsStringAsync(); }
            else
            {
                var hBody = await hRes.Content.ReadAsStringAsync();
                hostel = System.Text.Json.JsonSerializer.Deserialize<HostelDto>(hBody, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true });
                // rooms
                var rRes = await client.GetAsync($"/api/v1.0/Rooms/available/{Id}");
                if (rRes.IsSuccessStatusCode)
                {
                    var rBody = await rRes.Content.ReadAsStringAsync();
                    rooms = System.Text.Json.JsonSerializer.Deserialize<List<RoomDto>>(rBody, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true}) ?? new();
                }
            }
        }
        catch (Exception) { error = "The accommodation service is temporarily unavailable. Please try again in a moment."; }
        isLoading = false; roomsLoading = false;
    }

    private async Task Apply(int roomId)
    {
        applyBusy = roomId; feedbackRoomId = roomId; applyMsg = "Submitting your application…"; applyError = false;
        try
        {
            var client = await Auth.CreateAuthenticatedApiClientAsync();
            // 1) resolve studentId from JWT (requires sign-in)
            var meRes = await client.GetAsync("/api/v1.0/Students/me");
            var meBody = await meRes.Content.ReadAsStringAsync();
            if (!meRes.IsSuccessStatusCode)
            {
                if ((int)meRes.StatusCode == 401) applyMsg = "Your session has expired. Please sign in and try again.";
                else if ((int)meRes.StatusCode == 404) applyMsg = "Student profile not found — register again or contact admin.";
                else applyMsg = $"Cannot load profile ({(int)meRes.StatusCode}): {ExtractError(meBody)}";
                applyError = true; return;
            }
            using var doc = System.Text.Json.JsonDocument.Parse(meBody);
            if (!doc.RootElement.TryGetProperty("student", out var st) || !st.TryGetProperty("id", out var idEl))
            { applyMsg = "Invalid profile response."; applyError = true; return; }
            var studentId = idEl.GetInt32();

            // 2) submit application (API validates: no pending, not allocated, room available)
            var payload = new { StudentId = studentId, RoomId = roomId };
            var res = await client.PostAsJsonAsync("/api/v1.0/Applications", payload);
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                applyMsg = $"Apply failed ({(int)res.StatusCode}): {ExtractError(body)}";
                applyError = true;
                // surface common 400 details
                if (body.Contains("already have a pending", StringComparison.OrdinalIgnoreCase))
                    applyMsg += " — check My Applications.";
                if (body.Contains("already allocated", StringComparison.OrdinalIgnoreCase))
                    applyMsg += " — you already have a room.";
                return;
            }
            applyMsg = "Application submitted. Opening your applications…";
            applyError = false;
            await Task.Delay(650);
            Nav.NavigateTo("/applications");
        }
        catch (Exception ex)
        {
            applyMsg = "The application service is temporarily unavailable. Please try again.";
            applyError = true;
            Console.WriteLine($"Apply error for room {roomId}: {ex}");
        }
        finally { applyBusy = null; }
    }

    private static string ExtractError(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "(empty response)";
        try
        {
            using var d = System.Text.Json.JsonDocument.Parse(json);
            if (d.RootElement.TryGetProperty("error", out var e) && e.ValueKind == System.Text.Json.JsonValueKind.String) return e.GetString()!;
            if (d.RootElement.TryGetProperty("title", out var t) && t.ValueKind == System.Text.Json.JsonValueKind.String) return t.GetString()!;
            if (d.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object && d.RootElement.TryGetProperty("value", out var v))
                return v.ToString();
        } catch {}
        return json.Length > 300 ? json[..300] : json;
    }

    private record HostelDto(int Id, string Name, string? Description, string Address, bool IsActive, int TotalCapacity, int TotalOccupancy, int AvailableSpots);
    private record RoomDto(int Id, string RoomNumber, int Capacity, int CurrentOccupancy, decimal PricePerSemester, bool IsAvailable, int HostelId, string HostelName);
}
