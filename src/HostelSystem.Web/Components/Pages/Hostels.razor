@page "/hostels"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Hostels — HostelSystem</PageTitle>

<h3>Hostels</h3>
<p class="text-muted">Browse hostels and available rooms.</p>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="row g-3">
        @foreach (var h in hostels)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(h.IsActive ? "" : "border-warning")">
                    <div class="card-body">
                        <h5 class="card-title">@h.Name <small class="text-muted">#@h.Id</small></h5>
                        <p class="card-text">@h.Address</p>
                        <p class="card-text"><small class="text-muted">@h.Description</small></p>
                        <div class="d-flex gap-2 mb-2">
                            <span class="badge bg-primary">@h.TotalCapacity capacity</span>
                            <span class="badge bg-success">@h.AvailableSpots available</span>
                            <span class="badge @(h.IsActive ? "bg-success" : "bg-warning text-dark")">@(h.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <p class="mb-1"><small>Occupancy: @h.TotalOccupancy / @h.TotalCapacity</small></p>
                        <a class="btn btn-sm btn-outline-primary" href="/hostels/@h.Id">View rooms</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-3">
        <small class="text-muted">Total: @totalCount • Page @currentPage / @totalPages</small>
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="Prev" disabled="@(currentPage<=1)">Prev</button>
        <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="Next" disabled="@(currentPage>=totalPages)">Next</button>
    </div>
}

@code {
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] public IConfiguration Config { get; set; } = default!;
    private string apiBase => Config["ApiBaseUrl"] ?? "http://localhost:8080";
    private List<HostelDto> hostels = new();
    private string? error;
    private bool isLoading = true;
    private int currentPage = 1; private int pageSize = 12;
    private int totalCount; private int totalPages;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        isLoading = true; error = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.GetAsync($"{apiBase}/api/v1.0/Hostels?onlyActive=false&page={currentPage}&pageSize={pageSize}");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) { error = body; return; }
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var paged = System.Text.Json.JsonSerializer.Deserialize<Paged<HostelDto>>(body, opts);
            if (paged is not null) { hostels = paged.Items.ToList(); totalCount = paged.TotalCount; totalPages = paged.TotalPages; }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isLoading = false; }
    }
    private async Task Prev() { if (currentPage>1) { currentPage--; await Load(); } }
    private async Task Next() { if (currentPage<totalPages) { currentPage++; await Load(); } }

    private record HostelDto(int Id, string Name, string? Description, string Address, bool IsActive, int TotalCapacity, int TotalOccupancy, int AvailableSpots);
    private record Paged<T>(IReadOnlyList<T> Items, int TotalCount, int Page, int PageSize, int TotalPages);
}
