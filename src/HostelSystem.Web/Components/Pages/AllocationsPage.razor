@page "/allocations"
@using HostelSystem.Web.Services.Auth
@attribute [Authorize]

<PageTitle>My Allocation — HostelSystem</PageTitle>

<header class="allocation-heading"><span class="eyebrow">Your confirmed room</span><h1>My allocation</h1><p>Review your room details and complete payment to secure your accommodation.</p></header>

@if (isLoading)
{
    <div class="loading-inline"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading your allocation…</span></div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <section class="allocation-empty"><h2>We couldn’t load your allocation</h2><p>@error</p><button class="btn btn-primary" @onclick="Load">Try again</button></section>
}
else if (alloc is null)
{
    <section class="allocation-empty"><h2>No active allocation yet</h2><p>You don’t have an active room allocation.</p><a class="btn btn-primary" href="/hostels">Browse available hostels</a></section>
}
else
{
    <section class="allocation-card">
        <div class="allocation-room"><span>Room</span><strong>@alloc.RoomNumber</strong><small>@alloc.HostelName</small></div>
        <dl><div><dt>Status</dt><dd><span class="allocation-status">@(alloc.IsActive ? "Active allocation" : "Checked out")</span></dd></div><div><dt>Allocated on</dt><dd>@alloc.AllocationDate.ToLocalTime().ToString("dd MMM yyyy")</dd></div><div><dt>Allocation reference</dt><dd>#@alloc.Id</dd></div></dl>
        <div class="payment-step">
            @if (allocationPayment is null)
            {
                <div><strong>Payment is being prepared</strong><p>Your payment request will appear shortly. Refresh this page in a moment.</p></div><button class="btn btn-outline-secondary" @onclick="Load">Refresh</button>
            }
            else if (allocationPayment.Status == "Completed")
            {
                <div><strong>Payment complete</strong><p>Your accommodation payment has been received.</p></div><a class="btn btn-outline-primary" href="/payments">View receipt</a>
            }
            else
            {
                <div><strong>Complete your payment</strong><p>GHS @allocationPayment.Amount.ToString("N2") is due @allocationPayment.DueDate.ToLocalTime().ToString("dd MMM yyyy").</p></div><button class="btn btn-primary" @onclick="MakePayment" disabled="@paymentBusy">@(paymentBusy ? "Opening Paystack…" : "Make payment")</button>
            }
        </div>
        <footer><a href="/payments">View payment history</a>@if (alloc.IsActive) { <button class="btn btn-link text-danger" @onclick="Checkout" disabled="@busy">@(busy ? "Checking out…" : "Check out of room")</button> }</footer>
    </section>
}
@if (!string.IsNullOrWhiteSpace(msg))
{
    <div class="alert @(msgError?"alert-danger":"alert-success") mt-3">@msg</div>
}

@code {
    [Inject] public AuthService Auth { get; set; } = default!;
    [Inject] public AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] public NavigationManager Nav { get; set; } = default!;
    private AllocationDto? alloc; private bool isLoading = true; private string? error; private string? msg; private bool msgError; private bool busy;
    private PaymentRow? allocationPayment; private bool paymentBusy; private string email = "";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Load();
        await InvokeAsync(StateHasChanged);
    }
    private async Task Load()
    {
        isLoading = true; error = null;
        try
        {
            var client = await Auth.CreateAuthenticatedApiClientAsync();
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            email = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? authState.User.FindFirst("email")?.Value ?? "";
            var res = await client.GetAsync("/api/v1.0/Allocations/me");
            var body = await res.Content.ReadAsStringAsync();
            if (res.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                alloc = null;
                allocationPayment = null;
                return;
            }
            if (!res.IsSuccessStatusCode)
            {
                error = res.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Your sign-in could not be verified. Please sign out and sign in again."
                    : ExtractError(body, "The allocation service could not complete the request.");
                alloc = null;
                return;
            }
            alloc = System.Text.Json.JsonSerializer.Deserialize<AllocationDto>(body, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true});
            var paymentResponse = await client.GetAsync("/api/v1.0/Payments/me");
            if (paymentResponse.IsSuccessStatusCode)
            {
                var payments = System.Text.Json.JsonSerializer.Deserialize<List<PaymentRow>>(await paymentResponse.Content.ReadAsStringAsync(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                allocationPayment = payments.FirstOrDefault(p => p.AllocationId == alloc?.Id);
            }
        }
        catch (Exception) { error = "The allocation service is temporarily unavailable. Please try again in a moment."; }
        finally { isLoading = false; }
    }
    private async Task Checkout()
    {
        if (alloc is null) return;
        busy = true; msg = null;
        try
        {
            var client = await Auth.CreateAuthenticatedApiClientAsync();
            var res = await client.PostAsync($"/api/v1.0/Allocations/{alloc.Id}/checkout", null);
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) { msg = ExtractError(body, "We couldn’t check you out of this room."); msgError = true; }
            else { msg = "Checked out — room released."; msgError = false; await Load(); }
        }
        catch (Exception) { msg = "The allocation service is temporarily unavailable."; msgError = true; }
        finally { busy = false; }
    }
    private async Task MakePayment()
    {
        if (allocationPayment is null) return;
        if (string.IsNullOrWhiteSpace(email)) { msg = "Your account email could not be found. Please sign in again."; msgError = true; return; }
        paymentBusy = true; msg = null;
        try
        {
            var client = await Auth.CreateAuthenticatedApiClientAsync();
            var response = await client.PostAsJsonAsync("/api/v1.0/Payments/initiate", new { paymentId = allocationPayment.Id, email, callbackUrl = $"{Nav.BaseUri}payments" });
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) { msg = ExtractError(body, "We couldn’t start your payment."); msgError = true; return; }
            var result = System.Text.Json.JsonSerializer.Deserialize<InitiateResult>(body, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (string.IsNullOrWhiteSpace(result?.AuthorizationUrl)) { msg = "Paystack did not return a checkout link. Please try again."; msgError = true; return; }
            Nav.NavigateTo(result.AuthorizationUrl, forceLoad: true);
        }
        catch (Exception) { msg = "The payment service is temporarily unavailable. Please try again."; msgError = true; }
        finally { paymentBusy = false; }
    }
    private static string ExtractError(string body, string fallback)
    {
        try { using var doc = System.Text.Json.JsonDocument.Parse(body); if (doc.RootElement.TryGetProperty("error", out var value)) return value.GetString() ?? fallback; }
        catch { }
        return fallback;
    }
    private record AllocationDto(int Id, int StudentId, string StudentName, int RoomId, string RoomNumber, string HostelName, DateTime AllocationDate, bool IsActive);
    private record PaymentRow(int Id, decimal Amount, string Status, string? TransactionReference, DateTime? PaidOn, DateTime DueDate, bool IsOverdue, int AllocationId);
    private record InitiateResult(string TransactionReference, decimal Amount, string? AuthorizationUrl, string? AccessCode, string Status);
}
