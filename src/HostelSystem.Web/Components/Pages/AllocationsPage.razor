@page "/allocations"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>My Allocation — HostelSystem</PageTitle>

<h3>My Allocation</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning">@error</div>
    <p><a href="/hostels">Browse hostels</a> to get allocated after approval.</p>
}
else if (alloc is null)
{
    <div class="alert alert-info">No active allocation.</div>
}
else
{
    <div class="card" style="max-width:560px">
        <div class="card-body">
            <h5 class="card-title">@alloc.RoomNumber <small class="text-muted">(@alloc.HostelName)</small></h5>
            <p>Allocation #@alloc.Id • Student #@alloc.StudentId</p>
            <p>Status: <span class="badge @(alloc.IsActive?"bg-success":"bg-secondary")">@(alloc.IsActive?"Active":"Checked out")</span></p>
            <p><small class="text-muted">Allocated: @alloc.AllocationDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></p>
            @if (alloc.IsActive)
            {
                <button class="btn btn-sm btn-outline-danger" @onclick="Checkout" disabled="@busy">@(busy?"Checking out...":"Checkout")</button>
            }
            <div class="mt-3">
                <a href="/payments">Go to Payments</a> • <a href="/hostels">Browse hostels</a>
            </div>
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(msg))
{
    <div class="alert @(msgError?"alert-danger":"alert-success") mt-3">@msg</div>
}

@code {
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] public IConfiguration Config { get; set; } = default!;
    private string apiBase => Config["ApiBaseUrl"] ?? "http://localhost:8080";
    private AllocationDto? alloc; private bool isLoading = true; private string? error; private string? msg; private bool msgError; private bool busy;
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        isLoading = true; error = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.GetAsync($"{apiBase}/api/v1.0/Allocations/me");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) { error = body; alloc = null; return; }
            alloc = System.Text.Json.JsonSerializer.Deserialize<AllocationDto>(body, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true});
        }
        catch (Exception ex) { error = ex.Message; }
        finally { isLoading = false; }
    }
    private async Task Checkout()
    {
        if (alloc is null) return;
        busy = true; msg = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.PostAsync($"{apiBase}/api/v1.0/Allocations/{alloc.Id}/checkout", null);
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) { msg = body; msgError = true; }
            else { msg = "Checked out — room released."; msgError = false; await Load(); }
        }
        catch (Exception ex) { msg = ex.Message; msgError = true; }
        finally { busy = false; }
    }
    private record AllocationDto(int Id, int StudentId, string StudentName, int RoomId, string RoomNumber, string HostelName, DateTime AllocationDate, bool IsActive);
}
