@page "/login"
@layout AuthLayout
@rendermode InteractiveServer
@using HostelSystem.Web.Services.Auth
@attribute [AllowAnonymous]

<PageTitle>Sign in — Hestia</PageTitle>

<section class="auth-card">
    <header class="auth-card-header">
        <span class="eyebrow">Welcome back</span>
        <h1>Sign in to your account</h1>
        <p>Enter your details to access the accommodation portal.</p>
    </header>

    <form @onsubmit="DoLogin" @onsubmit:preventDefault>
        <div class="field-group">
            <label for="login-email">Email address</label>
            <input id="login-email" type="email" class="form-control" @bind="email" placeholder="you@example.com" autocomplete="email" />
        </div>
        <div class="field-group">
            <div class="field-label-row"><label for="login-password">Password</label></div>
            <input id="login-password" type="password" class="form-control" @bind="password" placeholder="Enter your password" autocomplete="current-password" />
        </div>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }
        @if (!string.IsNullOrWhiteSpace(info))
        {
            <div class="alert alert-success" role="status">@info</div>
        }
        <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@busy">
            @if (busy) { <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> }
            @(busy ? "Signing in…" : "Sign in")
        </button>
    </form>

    <div class="auth-divider"><span>New to Hestia?</span></div>
    <a class="btn btn-outline-secondary w-100" href="/register">Create a student account</a>
    <p class="auth-home-link"><a href="/">← Back to home</a> • <a href="/logout">Clear session / Sign out</a></p>
    <p class="small text-muted">If you see 401 on <code>GET /Students/me</code>, your token is stale — click Clear session, then sign in again. Check F12 → Application → Local Storage.</p>
</section>

@code {
    [Inject] public AuthService Auth { get; set; } = default!;
    [Inject] public NavigationManager Nav { get; set; } = default!;

    private string email = "";
    private string password = "";
    private string? error;
    private string? info;
    private bool busy;

    private async Task DoLogin()
    {
        error = info = null;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        { error = "Enter your email address and password."; return; }
        busy = true;
        var (ok, err) = await Auth.LoginAsync(email.Trim(), password);
        busy = false;
        if (!ok) { error = err; return; }
        info = "Signed in successfully. Redirecting…";
        // forceLoad ensures circuit restarts and ProtectedLocalStorage JWT is read as authenticated (fixes stale ProtectedLocalStorage vs HTTP challenge mismatch)
        Nav.NavigateTo("/", forceLoad: true);
    }
}
