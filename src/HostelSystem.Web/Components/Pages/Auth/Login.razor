@page "/login"
@rendermode InteractiveServer
@using HostelSystem.Web.Services.Auth
@attribute [AllowAnonymous]

<PageTitle>Login — HostelSystem</PageTitle>

<h3>Login</h3>
<p class="text-muted">Sign in to access your hostel portal.</p>

<div class="card" style="max-width:480px">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input class="form-control" @bind="email" placeholder="student@example.com" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" @bind="password" />
        </div>
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger">@error</div>
        }
        @if (!string.IsNullOrWhiteSpace(info))
        {
            <div class="alert alert-success">@info</div>
        }
        <button class="btn btn-primary w-100" @onclick="DoLogin" disabled="@busy">
            @(busy ? "Signing in..." : "Sign in")
        </button>
        <p class="mt-3 text-center"><a href="/register">Create account</a> • <a href="/">Home</a></p>
        <small class="text-muted">Rate limited: 5 failed attempts / 15 min. Refresh token valid 7 days.</small>
    </div>
</div>

@code {
    [Inject] public AuthService Auth { get; set; } = default!;
    [Inject] public NavigationManager Nav { get; set; } = default!;

    private string email = "";
    private string password = "";
    private string? error;
    private string? info;
    private bool busy;

    private async Task DoLogin()
    {
        error = info = null;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        { error = "Email and password are required."; return; }
        busy = true;
        var (ok, err) = await Auth.LoginAsync(email.Trim(), password);
        busy = false;
        if (!ok) { error = err; return; }
        info = "Login successful — redirecting...";
        Nav.NavigateTo("/", forceLoad: false);
    }
}
