@page "/applications"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>My Applications — HostelSystem</PageTitle>

<h3>My Applications</h3>
<button class="btn btn-sm btn-outline-secondary mb-3" @onclick="Load">Refresh</button>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (apps.Count == 0)
{
    <div class="alert alert-info">No applications yet. <a href="/hostels">Browse hostels</a> to apply.</div>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>#</th><th>Room</th><th>Hostel</th><th>Status</th><th>Date</th><th>Reviewed</th><th>Action</th></tr></thead>
        <tbody>
            @foreach (var a in apps)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@(a.RoomNumber ?? a.RoomId.ToString())</td>
                    <td>@(a.HostelName ?? "-")</td>
                    <td><span class="badge bg-@(a.Status=="Pending"?"warning text-dark":a.Status=="Approved"?"success":a.Status=="Rejected"?"danger":"secondary")">@a.Status</span></td>
                    <td>@a.ApplicationDate.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>@(a.ReviewedBy ?? "-")</td>
                    <td>
                        @if (a.Status=="Pending" || a.Status=="Approved")
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Cancel(a.Id)" disabled="@(busy==a.Id)">@(busy==a.Id?"Cancelling...":"Cancel")</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (!string.IsNullOrWhiteSpace(msg))
{
    <div class="alert @(msgError?"alert-danger":"alert-success")">@msg</div>
}

@code {
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    private List<AppDto> apps = new(); private bool isLoading = true; private string? error; private string? msg; private bool msgError; private int? busy;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        isLoading = true; error = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.GetAsync("/api/v1.0/Applications/me");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) { error = ExtractError(body, "We couldn’t load your applications. Please try again."); return; }
            apps = System.Text.Json.JsonSerializer.Deserialize<List<AppDto>>(body, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true}) ?? new();
        }
        catch (Exception) { error = "The application service is temporarily unavailable. Please try again in a moment."; }
        finally { isLoading = false; }
    }
    private async Task Cancel(int id)
    {
        busy = id; msg = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.PostAsJsonAsync($"/api/v1.0/Applications/{id}/cancel", new { reason = "Cancelled by student" });
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) { msg = ExtractError(body, "We couldn’t cancel this application."); msgError = true; }
            else { msg = "Cancelled."; msgError = false; await Load(); }
        }
        catch (Exception) { msg = "The application service is temporarily unavailable."; msgError = true; }
        finally { busy = null; }
    }
    private static string ExtractError(string body, string fallback)
    {
        try { using var doc = System.Text.Json.JsonDocument.Parse(body); if (doc.RootElement.TryGetProperty("error", out var value)) return value.GetString() ?? fallback; }
        catch { }
        return fallback;
    }
    private record AppDto(int Id, int StudentId, int RoomId, string Status, DateTime ApplicationDate, DateTime? ReviewedOn, string? ReviewedBy, string? RejectionReason, string? RoomNumber, string? HostelName);
}
