@page "/admin/hostels"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Hostels & Rooms — Hestia Admin</PageTitle>

<header class="admin-heading">
    <div><span class="eyebrow">Property inventory</span><h1>Hostels & rooms</h1><p>Manage accommodation properties, capacity, and room inventory.</p></div>
    <button class="btn btn-primary" @onclick="OpenCreateHostel">+ Add hostel</button>
</header>

@if (isLoading)
{
    <div class="loading-inline"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading hostel inventory…</span></div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <section class="admin-state" role="alert"><h2>We couldn’t load the hostel inventory</h2><p>@error</p><button class="btn btn-primary" @onclick="Load">Try again</button></section>
}
else if (items.Count == 0)
{
    <section class="admin-state"><h2>No hostels have been added</h2><p>Create the first hostel and add its initial rooms in one guided flow.</p><button class="btn btn-primary" @onclick="OpenCreateHostel">Add first hostel</button></section>
}
else
{
    <section class="inventory-card">
        <div class="inventory-toolbar"><span>@items.Count properties</span><button class="btn btn-sm btn-outline-secondary" @onclick="Load">Refresh</button></div>
        <div class="table-responsive">
            <table class="table inventory-table">
                <thead><tr><th>Hostel</th><th>Status</th><th>Capacity</th><th>Availability</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var hostel in items)
                    {
                        <tr>
                            <td><strong>@hostel.Name</strong><small>@hostel.Address</small></td>
                            <td><span class="inventory-status @(hostel.IsActive ? "active" : null)">@(hostel.IsActive ? "Active" : "Inactive")</span></td>
                            <td>@hostel.TotalCapacity beds</td>
                            <td><strong>@hostel.AvailableSpots</strong> available</td>
                            <td class="inventory-actions">
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenAddRooms(hostel)">Add rooms</button>
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/hostels/{hostel.Id}")">View</a>
                                <button class="btn btn-sm @(hostel.IsActive ? "btn-outline-danger" : "btn-outline-success")" @onclick="() => ToggleActive(hostel)">@(hostel.IsActive ? "Deactivate" : "Activate")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(messageError ? "alert-danger" : "alert-success") mt-3" role="status">@message</div>
}

@if (modalOpen)
{
    <div class="modal-backdrop-custom" @onclick="CloseModal"></div>
    <section class="wizard-modal" role="dialog" aria-modal="true" aria-labelledby="wizard-title">
        <header class="wizard-header"><div><span class="eyebrow">@(creatingHostel ? "New property" : selectedHostel?.Name)</span><h2 id="wizard-title">@(creatingHostel ? "Create hostel and rooms" : "Add rooms")</h2></div><button class="modal-close" aria-label="Close" @onclick="CloseModal">×</button></header>
        <ol class="wizard-steps" aria-label="Progress">
            @if (creatingHostel) { <li class="@(wizardStep >= 1 ? "current" : null)"><span>1</span>Hostel</li> }
            <li class="@(wizardStep >= RoomStep ? "current" : null)"><span>@RoomStep</span>Rooms</li>
            <li class="@(wizardStep >= ReviewStep ? "current" : null)"><span>@ReviewStep</span>Review</li>
        </ol>

        <div class="wizard-body">
            @if (creatingHostel && wizardStep == 1)
            {
                <div class="wizard-copy"><h3>Hostel details</h3><p>Add the information students will use to identify this property.</p></div>
                <div class="form-grid-modal"><div class="field-full"><label for="hostel-name">Hostel name</label><input id="hostel-name" class="form-control" @bind="newName" placeholder="e.g. Akuafo Hall" /></div><div class="field-full"><label for="hostel-address">Address</label><input id="hostel-address" class="form-control" @bind="newAddress" placeholder="Campus location or address" /></div><div class="field-full"><label for="hostel-description">Description <span>Optional</span></label><textarea id="hostel-description" class="form-control" rows="3" @bind="newDescription" placeholder="A short description for students"></textarea></div></div>
            }
            else if (wizardStep == RoomStep)
            {
                <div class="wizard-copy"><h3>Add room inventory</h3><p>Add one or more rooms. You can add more rooms later.</p></div>
                <div class="room-entry"><div><label for="room-number">Room number</label><input id="room-number" class="form-control" @bind="roomNumber" placeholder="e.g. AK101" /></div><div><label for="room-capacity">Capacity</label><input id="room-capacity" class="form-control" type="number" min="1" @bind="roomCapacity" /></div><div><label for="room-price">Price / semester</label><input id="room-price" class="form-control" type="number" min="0" step="0.01" @bind="roomPrice" /></div><button class="btn btn-outline-primary" @onclick="AddRoomDraft" disabled="@(!CanAddRoom)">Add room</button></div>
                @if (roomDrafts.Count > 0)
                {
                    <div class="room-draft-list">@foreach (var room in roomDrafts) { <div><span><strong>@room.RoomNumber</strong><small>@room.Capacity beds · GHS @room.PricePerSemester.ToString("N2")</small></span><button aria-label="Remove room @room.RoomNumber" @onclick="() => roomDrafts.Remove(room)">×</button></div> }</div>
                }
                else
                {
                    <div class="rooms-empty">No rooms added yet.</div>
                }
            }
            else if (wizardStep == ReviewStep)
            {
                <div class="wizard-copy"><h3>Review and confirm</h3><p>Check these details before saving the changes.</p></div>
                <div class="review-panel">@if (creatingHostel) { <div><span>Hostel</span><strong>@newName</strong><small>@newAddress</small></div> }<div><span>Rooms to add</span><strong>@roomDrafts.Count</strong><small>@roomDrafts.Sum(r => r.Capacity) total beds</small></div><div><span>Semester value</span><strong>GHS @roomDrafts.Sum(r => r.PricePerSemester * r.Capacity).ToString("N2")</strong><small>At full occupancy</small></div></div>
            }

            @if (!string.IsNullOrWhiteSpace(modalError)) { <div class="alert alert-danger mt-3" role="alert">@modalError</div> }
        </div>
        <footer class="wizard-footer"><button class="btn btn-outline-secondary" @onclick="PreviousStep" disabled="@(wizardStep == 1 || (!creatingHostel && wizardStep == RoomStep))">Back</button><div><button class="btn btn-light" @onclick="CloseModal">Cancel</button>@if (wizardStep < ReviewStep) { <button class="btn btn-primary" @onclick="NextStep" disabled="@(!CanContinue)">Continue</button> } else { <button class="btn btn-primary" @onclick="SaveWizard" disabled="@busy">@(busy ? "Saving…" : creatingHostel ? "Create hostel" : "Add rooms")</button> }</div></footer>
    </section>
}

@code {
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    private readonly System.Text.Json.JsonSerializerOptions jsonOptions = new() { PropertyNameCaseInsensitive = true };
    private List<HostelRow> items = new();
    private bool isLoading = true, busy, messageError, modalOpen, creatingHostel;
    private string? error, message, modalError;
    private HostelRow? selectedHostel;
    private int wizardStep = 1;
    private string newName = "", newAddress = "", newDescription = "";
    private string roomNumber = "";
    private int roomCapacity = 1;
    private decimal roomPrice;
    private List<RoomDraft> roomDrafts = new();
    private int RoomStep => creatingHostel ? 2 : 1;
    private int ReviewStep => creatingHostel ? 3 : 2;
    private bool CanAddRoom => !string.IsNullOrWhiteSpace(roomNumber) && roomCapacity > 0 && roomPrice > 0;
    private bool CanContinue => wizardStep == 1 && creatingHostel ? !string.IsNullOrWhiteSpace(newName) && !string.IsNullOrWhiteSpace(newAddress) : wizardStep == RoomStep && roomDrafts.Count > 0;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        isLoading = true; error = null;
        try
        {
            var response = await HttpFactory.CreateClient("Api").GetAsync("/api/v1.0/Hostels?onlyActive=false&page=1&pageSize=50");
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) { error = ExtractError(body, "We couldn’t load the hostel inventory."); return; }
            var result = System.Text.Json.JsonSerializer.Deserialize<PagedResult<HostelRow>>(body, jsonOptions);
            items = result?.Items?.ToList() ?? new();
        }
        catch (Exception) { error = "The hostel service is temporarily unavailable. Please try again."; }
        finally { isLoading = false; }
    }

    private void OpenCreateHostel() { ResetWizard(); creatingHostel = true; wizardStep = 1; modalOpen = true; }
    private void OpenAddRooms(HostelRow hostel) { ResetWizard(); creatingHostel = false; selectedHostel = hostel; wizardStep = 1; modalOpen = true; }
    private void CloseModal() { if (busy) return; modalOpen = false; }
    private void ResetWizard() { modalError = null; selectedHostel = null; newName = newAddress = newDescription = roomNumber = ""; roomCapacity = 1; roomPrice = 0; roomDrafts = new(); }
    private void NextStep() { if (CanContinue) { modalError = null; wizardStep++; } }
    private void PreviousStep() { if (wizardStep > 1) { modalError = null; wizardStep--; } }
    private void AddRoomDraft() { if (!CanAddRoom) return; if (roomDrafts.Any(r => r.RoomNumber.Equals(roomNumber.Trim(), StringComparison.OrdinalIgnoreCase))) { modalError = "Room numbers must be unique in this batch."; return; } roomDrafts.Add(new(roomNumber.Trim(), roomCapacity, roomPrice)); roomNumber = ""; roomCapacity = 1; roomPrice = 0; modalError = null; }

    private async Task SaveWizard()
    {
        busy = true; modalError = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var hostelId = selectedHostel?.Id ?? 0;
            if (creatingHostel)
            {
                var hostelResponse = await client.PostAsJsonAsync("/api/v1.0/Hostels", new { name = newName.Trim(), address = newAddress.Trim(), description = string.IsNullOrWhiteSpace(newDescription) ? null : newDescription.Trim() });
                var hostelBody = await hostelResponse.Content.ReadAsStringAsync();
                if (!hostelResponse.IsSuccessStatusCode) { modalError = ExtractError(hostelBody, "We couldn’t create this hostel."); return; }
                hostelId = System.Text.Json.JsonSerializer.Deserialize<HostelRow>(hostelBody, jsonOptions)?.Id ?? 0;
                if (hostelId == 0) { modalError = "The hostel was created but its identifier was not returned."; return; }
            }

            foreach (var room in roomDrafts)
            {
                var roomResponse = await client.PostAsJsonAsync("/api/v1.0/Rooms", new { roomNumber = room.RoomNumber, capacity = room.Capacity, pricePerSemester = room.PricePerSemester, hostelId });
                if (!roomResponse.IsSuccessStatusCode) { modalError = $"Hostel saved, but room {room.RoomNumber} could not be added: {ExtractError(await roomResponse.Content.ReadAsStringAsync(), "Unknown room error.")}"; return; }
            }
            message = creatingHostel ? $"{newName} and {roomDrafts.Count} room(s) created." : $"{roomDrafts.Count} room(s) added to {selectedHostel?.Name}.";
            messageError = false; modalOpen = false; await Load();
        }
        catch (Exception) { modalError = "The hostel service is temporarily unavailable. Please try again."; }
        finally { busy = false; }
    }

    private async Task ToggleActive(HostelRow hostel)
    {
        try
        {
            var action = hostel.IsActive ? "deactivate" : "activate";
            var response = await HttpFactory.CreateClient("Api").PostAsync($"/api/v1.0/Hostels/{hostel.Id}/{action}", null);
            var body = await response.Content.ReadAsStringAsync();
            message = response.IsSuccessStatusCode ? $"{hostel.Name} was {(hostel.IsActive ? "deactivated" : "activated")}." : ExtractError(body, "We couldn’t update this hostel.");
            messageError = !response.IsSuccessStatusCode;
            if (response.IsSuccessStatusCode) await Load();
        }
        catch (Exception) { message = "The hostel service is temporarily unavailable."; messageError = true; }
    }

    private static string ExtractError(string body, string fallback) { try { using var doc = System.Text.Json.JsonDocument.Parse(body); if (doc.RootElement.TryGetProperty("error", out var value)) return value.GetString() ?? fallback; } catch { } return fallback; }
    private record HostelRow(int Id, string Name, string? Description, string Address, bool IsActive, int TotalCapacity, int TotalOccupancy, int AvailableSpots);
    private record PagedResult<T>(IReadOnlyList<T> Items, int TotalCount, int Page, int PageSize, int TotalPages);
    private record RoomDraft(string RoomNumber, int Capacity, decimal PricePerSemester);
}
