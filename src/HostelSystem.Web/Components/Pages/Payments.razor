@page "/payments"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Payment History — Hestia</PageTitle>

<header class="payments-heading">
    <div><span class="eyebrow">Transactions</span><h1>Payment history</h1><p>Review accommodation payments and check their current status.</p></div>
    <button class="btn btn-outline-secondary" @onclick="LoadHistory" disabled="@historyLoading">@(historyLoading ? "Refreshing…" : "Refresh")</button>
</header>

@if (historyLoading)
{
    <div class="loading-inline" aria-live="polite"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Loading your payments…</span></div>
}
else if (!string.IsNullOrWhiteSpace(historyError))
{
    <section class="payment-state" role="alert"><h2>We couldn’t load your payments</h2><p>@historyError</p><button class="btn btn-primary" @onclick="LoadHistory">Try again</button></section>
}
else if (history.Count == 0)
{
    <section class="payment-state"><h2>No payments yet</h2><p>A payment will be created after your room application is approved and an allocation is confirmed.</p><a class="btn btn-primary" href="/applications">View applications</a></section>
}
else
{
    <section class="payments-card">
        <div class="payments-summary"><div><span>Total transactions</span><strong>@history.Count</strong></div><div><span>Completed</span><strong>@history.Count(p => p.Status == "Completed")</strong></div><div><span>Outstanding</span><strong>GHS @history.Where(p => p.Status == "Pending").Sum(p => p.Amount).ToString("N2")</strong></div></div>
        <div class="table-responsive">
            <table class="table payment-table">
                <thead><tr><th>Payment</th><th>Amount</th><th>Status</th><th>Due date</th><th>Paid on</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var payment in history.OrderByDescending(p => p.Id))
                    {
                        <tr>
                            <td><strong>#@payment.Id</strong>@if (!string.IsNullOrWhiteSpace(payment.TransactionReference)) { <small>@payment.TransactionReference</small> }</td>
                            <td><strong>GHS @payment.Amount.ToString("N2")</strong></td>
                            <td><span class="payment-status @payment.Status.ToLowerInvariant()">@payment.Status</span></td>
                            <td><span class="@(payment.IsOverdue && payment.Status == "Pending" ? "overdue" : null)">@payment.DueDate.ToLocalTime().ToString("dd MMM yyyy")</span></td>
                            <td>@(payment.PaidOn?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                            <td class="payment-actions">
                                @if (!string.IsNullOrWhiteSpace(payment.TransactionReference))
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"/payments/{payment.TransactionReference}")">View details</a>
                                    @if (payment.Status == "Pending") { <button class="btn btn-sm btn-outline-secondary" @onclick="() => Verify(payment.TransactionReference!)" disabled="@(verifyingReference == payment.TransactionReference)">@(verifyingReference == payment.TransactionReference ? "Checking…" : "Check status")</button> }
                                }
                                else if (payment.Status == "Pending")
                                {
                                    <a class="btn btn-sm btn-primary" href="/allocations">Pay from allocation</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(verifyMessage))
{
    <div class="alert @(verifyError ? "alert-danger" : "alert-success") mt-3" role="status">@verifyMessage</div>
}

@code {
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    private List<PaymentRow> history = new();
    private bool historyLoading = true;
    private string? historyError;
    private string? verifyMessage;
    private bool verifyError;
    private string? verifyingReference;

    protected override async Task OnInitializedAsync() => await LoadHistory();

    private async Task LoadHistory()
    {
        historyLoading = true; historyError = null;
        try
        {
            var response = await HttpFactory.CreateClient("Api").GetAsync("/api/v1.0/Payments/me");
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) { historyError = ExtractError(body, "We couldn’t load your payment history."); return; }
            history = System.Text.Json.JsonSerializer.Deserialize<List<PaymentRow>>(body, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch (Exception) { historyError = "The payment service is temporarily unavailable. Please try again in a moment."; }
        finally { historyLoading = false; }
    }

    private async Task Verify(string reference)
    {
        verifyingReference = reference; verifyMessage = null; verifyError = false;
        try
        {
            var response = await HttpFactory.CreateClient("Api").GetAsync($"/api/v1.0/Payments/{Uri.EscapeDataString(reference)}/verify");
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) { verifyMessage = ExtractError(body, "We couldn’t verify this payment."); verifyError = true; return; }
            verifyMessage = "Payment status updated.";
            await LoadHistory();
        }
        catch (Exception) { verifyMessage = "The payment service is temporarily unavailable."; verifyError = true; }
        finally { verifyingReference = null; }
    }

    private static string ExtractError(string body, string fallback)
    {
        try { using var doc = System.Text.Json.JsonDocument.Parse(body); if (doc.RootElement.TryGetProperty("error", out var value)) return value.GetString() ?? fallback; }
        catch { }
        return fallback;
    }

    private record PaymentRow(int Id, decimal Amount, string Status, string? TransactionReference, DateTime? PaidOn, DateTime DueDate, bool IsOverdue, string? PaymentMethod, int AllocationId);
}
