@page "/payments"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Payments — HostelSystem</PageTitle>

<h3>Payments</h3>
<p class="text-muted">Your payments history • Initiate via Paystack or scan QR.</p>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">My Payments</h5>
        <button class="btn btn-sm btn-outline-secondary mb-2" @onclick="LoadHistory">Refresh</button>
        @if (historyLoading)
        {
            <p>Loading...</p>
        }
        else if (!string.IsNullOrWhiteSpace(historyError))
        {
            <div class="alert alert-warning">@historyError</div>
        }
        else if (history.Count == 0)
        {
            <div class="alert alert-info">No payments yet. Apply and get approved — a payment will appear automatically.</div>
        }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>#</th><th>Amount</th><th>Status</th><th>Reference</th><th>Due</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var p in history)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>GHS @p.Amount</td>
                            <td><span class="badge bg-@(p.Status=="Completed"?"success":p.Status=="Pending"?"warning text-dark":p.Status=="Refunded"?"info":"secondary")">@p.Status</span></td>
                            <td><code>@(p.TransactionReference ?? "-")</code></td>
                            <td>@p.DueDate.ToLocalTime().ToString("yyyy-MM-dd") @(p.IsOverdue ? "(overdue)" : "")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(p.TransactionReference))
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="/payments/@p.TransactionReference">QR</a>
                                    @if (p.Status=="Pending")
                                    {
                                        <button class="btn btn-sm btn-outline-success ms-1" @onclick="() => Verify(p.TransactionReference!)">Verify</button>
                                    }
                                }
                                else if (p.Status=="Pending")
                                {
                                    <small class="text-muted">Initiate below</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (!string.IsNullOrWhiteSpace(verifyMsg))
        {
            <div class="alert @(verifyError?"alert-danger":"alert-success")">@verifyMsg</div>
        }
    </div>
</div>

<div class="card mb-4" style="max-width:560px">
    <div class="card-body">
        <h5 class="card-title">Initiate Payment</h5>
        <div class="mb-3">
            <label class="form-label">Payment ID</label>
            <input class="form-control" @bind="paymentId" type="number" placeholder="e.g. 1" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email (for Paystack receipt)</label>
            <input class="form-control" @bind="email" placeholder="student@example.com" />
        </div>
        <button class="btn btn-primary" @onclick="Initiate" disabled="@isSubmitting">
            @(isSubmitting ? "Initiating..." : "Initiate with Paystack")
        </button>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert alert-@(isError ? "danger" : "success") mt-3">@message</div>
        }
        @if (lastResult is not null)
        {
            <div class="mt-3">
                <p>Reference: <code>@lastResult.TransactionReference</code> • Amount: <strong>GHS @lastResult.Amount</strong></p>
                @if (!string.IsNullOrWhiteSpace(lastResult.AuthorizationUrl))
                {
                    <a class="btn btn-success btn-sm" href="@lastResult.AuthorizationUrl" target="_blank">Open Paystack Checkout</a>
                }
                <div class="mt-3">
                    <p class="mb-1"><small>QR (encodes reference + amount + currency):</small></p>
                    <img src="@($"{apiBase}/api/v1.0/Payments/{lastResult.TransactionReference}/qr?format=png")"
                         alt="QR @lastResult.TransactionReference" style="max-width:260px; border:1px solid #ddd; padding:6px; background:white;" />
                    <div class="mt-2">
                        <a href="@($"{apiBase}/api/v1.0/Payments/{lastResult.TransactionReference}/qr?format=png")" target="_blank" class="btn btn-outline-secondary btn-sm">PNG</a>
                        <a href="@($"{apiBase}/api/v1.0/Payments/{lastResult.TransactionReference}/qr?format=svg")" target="_blank" class="btn btn-outline-secondary btn-sm ms-1">SVG</a>
                        <a href="@($"/payments/{lastResult.TransactionReference}")" class="btn btn-outline-primary btn-sm ms-1">Details →</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="card" style="max-width:560px">
    <div class="card-body">
        <h5 class="card-title">View QR by Reference</h5>
        <div class="input-group">
            <input class="form-control" @bind="viewRef" placeholder="HS-1-20260825-AB12CD34" />
            <a class="btn btn-outline-primary" href="@($"/payments/{viewRef}")">View</a>
        </div>
        <small class="text-muted">Enter a transaction reference (e.g. HS-...) to see its QR.</small>
    </div>
</div>

@code {
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;
    [Inject] public IConfiguration Config { get; set; } = default!;
    private string apiBase => Config["ApiBaseUrl"] ?? "http://localhost:8080";

    private int paymentId;
    private string email = "";
    private string viewRef = "";
    private string? message;
    private bool isError;
    private bool isSubmitting;
    private InitiateResult? lastResult;

    private List<PaymentRow> history = new();
    private bool historyLoading = true;
    private string? historyError;
    private string? verifyMsg; private bool verifyError;

    protected override async Task OnInitializedAsync() => await LoadHistory();
    private async Task LoadHistory()
    {
        historyLoading = true; historyError = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.GetAsync($"{apiBase}/api/v1.0/Payments/me");
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode) { historyError = body; return; }
            history = System.Text.Json.JsonSerializer.Deserialize<List<PaymentRow>>(body, new System.Text.Json.JsonSerializerOptions{ PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch (Exception ex) { historyError = ex.Message; }
        finally { historyLoading = false; }
    }
    private async Task Verify(string reference)
    {
        verifyMsg = null; verifyError = false;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.GetAsync($"{apiBase}/api/v1.0/Payments/{reference}/verify");
            var body = await res.Content.ReadAsStringAsync();
            verifyMsg = res.IsSuccessStatusCode ? $"Verified: {body}" : body;
            verifyError = !res.IsSuccessStatusCode;
            if (res.IsSuccessStatusCode) await LoadHistory();
        }
        catch (Exception ex) { verifyMsg = ex.Message; verifyError = true; }
    }
    private record PaymentRow(int Id, decimal Amount, string Status, string? TransactionReference, DateTime? PaidOn, DateTime DueDate, bool IsOverdue);

    private async Task Initiate()
    {
        isError = false; message = null;
        if (paymentId <= 0 || string.IsNullOrWhiteSpace(email))
        {
            isError = true; message = "Payment ID and email are required."; return;
        }
        isSubmitting = true;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.PostAsJsonAsync($"{apiBase}/api/v1.0/Payments/initiate", new { paymentId, email });
            var body = await res.Content.ReadAsStringAsync();
            if (!res.IsSuccessStatusCode)
            {
                isError = true; message = body; return;
            }
            lastResult = System.Text.Json.JsonSerializer.Deserialize<InitiateResult>(body, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            message = "Initialized — open Paystack checkout or scan QR.";
        }
        catch (Exception ex) { isError = true; message = ex.Message; }
        finally { isSubmitting = false; }
    }

    private record InitiateResult(string TransactionReference, decimal Amount, string? AuthorizationUrl, string? AccessCode, string Status);
}
