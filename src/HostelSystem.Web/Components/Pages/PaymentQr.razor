@page "/payments/{Reference}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Payment QR — Hestia</PageTitle>

<div class="page-heading-basic">
    <span class="eyebrow">Secure payment</span>
    <h1>Payment QR</h1>
    <p>Reference <code>@Reference</code></p>
</div>

<div class="card content-card content-card-narrow">
    <div class="card-body">
        <p class="text-muted">Scan this code to retrieve the payment reference, amount, and currency.</p>

        <section class="qr-panel" aria-busy="@qrLoading">
            @if (qrLoading)
            {
                <div class="loading-inline" aria-live="polite"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Preparing secure QR…</span></div>
            }
            else if (!string.IsNullOrWhiteSpace(qrError))
            {
                <div class="alert alert-warning" role="alert">@qrError <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="LoadQr">Retry</button></div>
            }
            else if (!string.IsNullOrWhiteSpace(qrPngData))
            {
                <img class="payment-qr" src="@qrPngData" width="300" height="300" alt="Payment QR for @Reference" />
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <a href="@qrPngData" download="@($"{Reference}.png")" class="btn btn-outline-secondary btn-sm">Download PNG</a>
                    @if (!string.IsNullOrWhiteSpace(qrSvgData))
                    {
                        <a href="@qrSvgData" download="@($"{Reference}.svg")" class="btn btn-outline-secondary btn-sm">Download SVG</a>
                    }
                </div>
            }
        </section>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-4">
            <button class="btn btn-outline-primary btn-sm" @onclick="Verify" disabled="@verifying">@(verifying ? "Verifying…" : "Verify via Paystack")</button>
            <span role="status">@verifyMessage</span>
        </div>
        <a class="back-link" href="/payments">← Back to payments</a>
    </div>
</div>

@code {
    [Parameter] public string Reference { get; set; } = string.Empty;
    [Inject] public IHttpClientFactory HttpFactory { get; set; } = default!;

    private string? qrPngData;
    private string? qrSvgData;
    private string? qrError;
    private bool qrLoading;
    private bool verifying;
    private string? verifyMessage;

    protected override async Task OnParametersSetAsync() => await LoadQr();

    private async Task LoadQr()
    {
        qrLoading = true; qrError = null; qrPngData = null; qrSvgData = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var safeReference = Uri.EscapeDataString(Reference);
            var pngTask = client.GetAsync($"/api/v1.0/Payments/{safeReference}/qr?format=png");
            var svgTask = client.GetAsync($"/api/v1.0/Payments/{safeReference}/qr?format=svg");
            await Task.WhenAll(pngTask, svgTask);

            if (!pngTask.Result.IsSuccessStatusCode)
            {
                qrError = "This QR is unavailable or you do not have access to this payment.";
                return;
            }

            qrPngData = $"data:image/png;base64,{Convert.ToBase64String(await pngTask.Result.Content.ReadAsByteArrayAsync())}";
            if (svgTask.Result.IsSuccessStatusCode)
                qrSvgData = $"data:image/svg+xml;base64,{Convert.ToBase64String(await svgTask.Result.Content.ReadAsByteArrayAsync())}";
        }
        catch (Exception ex) { qrError = ex.Message; }
        finally { qrLoading = false; }
    }

    private async Task Verify()
    {
        verifying = true; verifyMessage = null;
        try
        {
            var client = HttpFactory.CreateClient("Api");
            var res = await client.GetAsync($"/api/v1.0/Payments/{Uri.EscapeDataString(Reference)}/verify");
            var body = await res.Content.ReadAsStringAsync();
            verifyMessage = res.IsSuccessStatusCode ? "Payment status refreshed." : $"Verification failed: {body}";
        }
        catch (Exception ex) { verifyMessage = ex.Message; }
        finally { verifying = false; }
    }
}
