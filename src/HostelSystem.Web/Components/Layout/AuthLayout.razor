@inherits LayoutComponentBase

<div class="auth-layout">
    <a class="auth-brand" href="/" aria-label="Hestia home">
        <span class="brand-mark">H</span>
        <span>Hestia</span>
    </a>

    <div class="auth-backdrop auth-backdrop-one"></div>
    <div class="auth-backdrop auth-backdrop-two"></div>

    <main class="auth-main">
        @Body
    </main>

    <footer class="auth-footer">Secure hostel accommodation management</footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>
