<div class="nav-header">
    <a class="nav-brand" href="/">
        <span class="brand-mark">H</span>
        <span>
            <strong>Hestia</strong>
            <small>Accommodation</small>
        </span>
    </a>
    <button type="button" class="nav-toggle-label" aria-label="Toggle navigation" aria-expanded="@navOpen" @onclick="ToggleNavigation"><span></span><span></span><span></span></button>
</div>

<div class="nav-scrollable @(navOpen ? "open" : null)">
    <nav class="nav flex-column" aria-label="Portal navigation">
        <AuthorizeView Roles="Student">
            <Authorized>
                <div class="nav-section-label">Student portal</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseNavigation"><UiIcon Name="home" />Overview</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="hostels" @onclick="CloseNavigation"><UiIcon Name="building" />Find a hostel</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="applications" @onclick="CloseNavigation"><UiIcon Name="document" />My applications</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="allocations" @onclick="CloseNavigation"><UiIcon Name="key" />My allocation</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="payments" @onclick="CloseNavigation"><UiIcon Name="wallet" />Payments</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-section-label">Administration</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All" @onclick="CloseNavigation"><UiIcon Name="home" />Dashboard</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/applications" @onclick="CloseNavigation"><UiIcon Name="check" />Applications</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/hostels" @onclick="CloseNavigation"><UiIcon Name="building" />Hostels & rooms</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/allocations" @onclick="CloseNavigation"><UiIcon Name="key" />Allocations</NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/payments" @onclick="CloseNavigation"><UiIcon Name="wallet" />Payments</NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="nav-footer">
        <NavLink class="nav-link logout-link" href="logout" @onclick="CloseNavigation"><UiIcon Name="logout" />Sign out</NavLink>
        <small>Hestia Management System</small>
    </div>
</div>

@code {
    private bool navOpen;
    private void ToggleNavigation() => navOpen = !navOpen;
    private void CloseNavigation() => navOpen = false;
}
