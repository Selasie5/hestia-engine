DatabaseProvider=Sqlite
ConnectionStrings__DefaultConnection=Data Source=hostelsystem.db
# For SQL Server (production):
# DatabaseProvider=SqlServer
# ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=HostelSystem;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True

Jwt__Secret=replace-with-a-strong-random-secret
Jwt__Issuer=HostelSystem.Api
Jwt__Audience=HostelSystem.Web

# Paystack (never commit real keys — use dotnet user-secrets or env vars)
# dotnet user-secrets set "Paystack:SecretKey" "sk_test_..."
Paystack__SecretKey=sk_test_replace_me
Paystack__PublicKey=pk_test_replace_me
Paystack__Currency=GHS
# Paystack__CallbackUrl=https://your-app.com/api/v1.0/Payments/callback

# SMTP (Mailtrap for dev, console fallback if empty)
# dotnet user-secrets set "Smtp:Host" "smtp.mailtrap.io"
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=noreply@hostelsystem.local